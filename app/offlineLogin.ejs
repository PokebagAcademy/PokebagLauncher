<div id="offlineLoginContainer" style="display: none;">
    <div id="offlineLoginCancelContainer" style="display: none;">
        <button id="offlineLoginCancelButton">
            <div id="loginCancelIcon">X</div>
            <span id="loginCancelText"><%- lang('login.loginCancelText') %></span>
        </button>
    </div>
    <div id="loginContent">
        <form id="offlineLoginForm">
            <img id="loginImageSeal" src="assets/images/logo-full.png"/>
            <span id="offlineLoginSubheader"><%- lang('loginOptions.loginCrack') %></span>
            <div class="loginFieldContainer">
                <svg id="profileSVG" class="loginSVG" viewBox="40 37 65.36 61.43">
                    <g>
                        <path d="M86.77,58.12A13.79,13.79,0,1,0,73,71.91,13.79,13.79,0,0,0,86.77,58.12M97,103.67a3.41,3.41,0,0,0,3.39-3.84,27.57,27.57,0,0,0-54.61,0,3.41,3.41,0,0,0,3.39,3.84Z"/>
                    </g>
                </svg>
                <span class="loginErrorSpan" id="offlineLoginUsernameError"></span>
                <input id="offlineLoginUsername" class="loginField" type="text" placeholder="<%- lang('landing.usernamePlaceholder') %>"/>
            </div>
            <button id="offlineLoginButton" disabled>
                <div id="loginButtonContent">
                    <%- lang('login.loginButtonText') %>
                    <svg id="loginSVG" viewBox="0 0 24.87 13.97">
                        <defs>
                            <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                        </defs>
                        <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                    </svg>
                    <div class="circle-loader">
                        <div class="checkmark draw"></div>
                    </div>
                </div>
            </button>
        </form>
    </div>
    <script src="./assets/js/scripts/offlineLogin.js"></script>
</div>
