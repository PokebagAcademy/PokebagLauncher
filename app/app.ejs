<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <script src="./assets/js/scripts/sfx.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            background-color: #171614;
            -webkit-user-select: none;
        }
        /* Background lives in its own layer so a clarity/vividness filter
           can be applied to the photo without blurring text or UI on top. */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            z-index: -1;
            background-image: var(--bg-image, url('assets/images/backgrounds/<%=bkid%>.png'));
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            transition: background-image 1s ease;
            filter: contrast(1.1) saturate(1.25) brightness(1.04);
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('offlineLogin') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/load.png">
            </div>
        </div>
    </div>
</body>
</html>